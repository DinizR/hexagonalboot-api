# Copy this file to the porto-workspace directory (the folder that contains
# hexagonalboot-api, porto-api-plugins, and the *-api-deploy trees).
# porto-workspace is not a git repository — each developer creates this locally:
#
#   cp hexagonalboot-api/docs/porto-workspace.envrc ../.envrc
#   direnv allow
#
# Change PORTO_API_APPLICATION to switch apps, then `direnv allow` again.
export PORTO_API_APPLICATION=shine-media
export PORTO_API_HOME="$PWD/${PORTO_API_APPLICATION}-api-deploy"
export API_ENV="${API_ENV:-dev}"
export LOG_PATH="${LOG_PATH:-$PORTO_API_HOME/logs}"
