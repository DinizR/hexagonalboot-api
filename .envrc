# Inherit porto-workspace/.envrc (current app). Override with .envrc.local if needed.
source_up_if_exists
source_env_if_exists .envrc.local

if [[ -z "${PORTO_API_HOME:-}" ]]; then
  export PORTO_API_APPLICATION="${PORTO_API_APPLICATION:-shine-media}"
  export PORTO_API_HOME="$(cd "$PWD/../${PORTO_API_APPLICATION}-api-deploy" && pwd)"
fi

export API_ENV="${API_ENV:-dev}"
export LOG_PATH="${LOG_PATH:-$PORTO_API_HOME/logs}"
